# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_WEBHOOK_URL=https://example.com
TELEGRAM_WEBHOOK_SECRET=replace-with-long-secret
TELEGRAM_DROP_PENDING_UPDATES=true
TELEGRAM_SESSION_ENABLED=false

# Policies
# Comma-separated Telegram IDs. Empty means "disabled".
TELEGRAM_ALLOWLIST_IDS=
TELEGRAM_ADMIN_IDS=

# Feature flags
# Comma-separated module names enabled in features composition root.
FEATURES_ENABLED=template-status
# Command-level flags inside the template-status feature module.
FEATURE_TEMPLATE_PING_ENABLED=true
FEATURE_TEMPLATE_ADMIN_STATUS_ENABLED=false

# Primary domain persistence (business repositories)
PRIMARY_DB=postgres
DATABASE_URL=postgres://app:app@127.0.0.1:5433/app
POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=10

# Redis (always-on cross-cutting adapters)
REDIS_URL=redis://127.0.0.1:6380
IDEMPOTENCY_TTL_SECONDS=86400

# Optional broker (used only when broker-dependent modules are enabled)
BROKER_ENABLED=false
AMQP_URL=amqp://guest:guest@127.0.0.1:5672

# Broadcast defaults (optional system module)
BROADCAST_EXCHANGE=broadcast.exchange
BROADCAST_CHUNK_QUEUE=broadcast.chunk
BROADCAST_RETRY_QUEUE=broadcast.chunk.retry
BROADCAST_DLQ_QUEUE=broadcast.chunk.dlq
BROADCAST_CHUNK_SIZE=100
BROADCAST_PREFETCH=20
BROADCAST_CONCURRENCY=2
BROADCAST_RETRY_MAX_ATTEMPTS=5
BROADCAST_RETRY_BASE_DELAY_MS=1000
BROADCAST_RETRY_MAX_DELAY_MS=30000
BROADCAST_IDEMPOTENCY_TTL_SECONDS=2592000
BROADCAST_GLOBAL_RATE_LIMIT_POINTS=20
BROADCAST_GLOBAL_RATE_LIMIT_DURATION_SECONDS=1
BROADCAST_RECOVERY_BATCH_SIZE=50
